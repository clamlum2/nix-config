# Syntax
color-link default "#EAF2FF,#161828"
color-link comment "#6C8AFF"
color-link identifier "#B4D7FF"
color-link constant "#9CDCFE"
color-link statement "#4EA1FF"
color-link symbol "#4EA1FF"
color-link preproc "#7AA2F7"
color-link type "#89DDFF"
color-link special "#C3A6FF"
color-link underlined "#B4D7FF"
color-link error "#E06C75"
color-link todo "#FFB86B"

# Editor UI
color-link selection "#FFFFFF,#2A3355"
color-link statusline "#B4D7FF,#1F2740"
color-link statusline.inactive "#6C7A9A,#181C2D"
color-link statusline.suggestions "#4EA1FF,#1F2740"

color-link tabbar "#B4D7FF,#181C2D"
color-link tabbar.active "#161828,#4EA1FF"

color-link indent-char "#2C3554"
color-link line-number "#6C7A9A"
color-link current-line-number "#4EA1FF"
color-link cursor-line "#1B2136"
color-link color-column "#EAF2FF,#202746"

color-link gutter-info "#4EA1FF"
color-link gutter-warning "#FFB86B"
color-link gutter-error "#E06C75"

color-link diff-added "#98C379"
color-link diff-modified "#4EA1FF"
color-link diff-deleted "#E06C75"

color-link ignore "#4B5678"
color-link scrollbar "#2C3554"
color-link divider "#2C3554"
color-link message "#B4D7FF,#181C2D"
color-link error-message "#FFFFFF,#E06C75"
color-link match-brace "#161828,#89DDFF"
color-link hlsearch "#161828,#FFB86B"
color-link tab-error "#161828,#E06C75"
color-link trailingws "#161828,#E06C75"