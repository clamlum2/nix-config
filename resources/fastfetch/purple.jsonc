{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
          "separator": " ➜  "
    },
    "logo": {
        "type": "builtin",
        "color": {
            "1": "#5B3BBF",
            "2": "#B76CFF"
        }
    },
    "modules": [
        "break",
        "break",
         {
            "type": "os",
            "format": "{2}",
            "key": "OS   ",
            "keyColor": "38;2;183;108;255",  // = color1 (#B76CFF)
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "38;2;183;108;255",
        },
        {
            "type": "packages",
            "format": "{1} (Nix)",
            "key": " ├ 󰏖 ",
            "keyColor": "38;2;183;108;255",
        },
        {
            "type": "shell",
            "format": "{6} {4}",
            "key": " └  ",
            "keyColor": "38;2;183;108;255",
        },
        "break",
        {
            "type": "wm",
            "format": "{2}",
            "key": "WM   ",
            "keyColor": "38;2;138;108;255",
        },
        {
            "type": "cursor",
            "format": "{1}",
            "key": " ├  ",
            "keyColor": "38;2;138;108;255",
        },
        {
            "type": "terminal",
            "format": "{5}",
            "key": " ├  ",
            "keyColor": "38;2;138;108;255",
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "38;2;138;108;255",
        },
        "break",
        {
            "type": "host",
            "format": "{2}",
            "key": "PC   ",
            "keyColor": "38;2;91;59;191",
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": " ├  ",
            "keyColor": "38;2;91;59;191",
        },
        {
            "type": "gpu",
            "format": "{1} {2}",
            "key": " ├ 󰢮 ",
            "keyColor": "38;2;91;59;191",
        },
        {
            "type": "memory",
            "format": "{1} ({3})",
            "key": " ├  ",
            "keyColor": "38;2;91;59;191",
        },
        {
            "type": "disk",
            "format": "{2} ({3})",
            "key": " ├ 󰋊 ",
            "keyColor": "38;2;91;59;191",
        },
        {
            "type": "monitor",
            "format": "{2}x{3}@{11}Hz ",
            "key": " ├  ",
            "keyColor": "38;2;91;59;191",
        },
        "break",
        "break",
    ]
}
